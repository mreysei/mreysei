# Where the content of the profile is read from: the portfolio. Required.
# For a portfolio in development: http://localhost:4000
PROFILE_SITE_URL=https://www.example.org

# The site whose counter of views the README shows. Defaults to PROFILE_SITE_URL. Always a public
# address: GitHub fetches the image, not this machine.
# PROFILE_VIEWS_SITE_URL=https://www.example.org

# Where README.md and assets/ are written. Defaults to the current folder.
# PROFILE_FOLDER=/tmp/profile-preview

# The CDN of the portfolio: the only place the photo and the banner of the hero are read from.
# Missing: a portfolio that sends its pictures stops the sync.
# PROFILE_CDN_URL=https://cdn.example.org

# The terminal and the play site, for a portfolio that does not name them yet in its content.
# Once it does, what it says wins. Missing: no button for that site (in the workflow, a
# repository variable can change the address, not remove it).
# PROFILE_TERMINAL_URL=https://terminal.example.org
# PROFILE_PLAY_URL=https://play.example.org
