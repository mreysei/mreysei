# Where the content of the profile is read from: the portfolio. Required.
# For a portfolio in development: http://localhost:4000
PROFILE_SITE_URL=https://www.example.org

# The site whose counter of views the README shows. Defaults to PROFILE_SITE_URL. Always a public
# address: GitHub fetches the image, not this machine.
# PROFILE_VIEWS_SITE_URL=https://www.example.org

# Where README.md and assets/ are written. Defaults to the current folder.
# PROFILE_FOLDER=/tmp/profile-preview
